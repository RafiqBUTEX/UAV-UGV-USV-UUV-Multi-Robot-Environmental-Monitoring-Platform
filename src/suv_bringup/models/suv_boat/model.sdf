<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="suv_boat">
    <pose>0 0 0.2 0 0 0</pose>
    <link name="hull">
      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>5</ixx>
          <iyy>10</iyy>
          <izz>12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>1.2 0.6 0.3</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1.2 0.6 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>

    <link name="left_thruster">
      <pose>-0.6 0.2 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="left_thruster_joint" type="revolute">
      <parent>hull</parent>
      <child>left_thruster</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
      </axis>
    </joint>

    <link name="right_thruster">
      <pose>-0.6 -0.2 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="right_thruster_joint" type="revolute">
      <parent>hull</parent>
      <child>right_thruster</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
      </axis>
    </joint>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>hull::imu_sensor</imuName>
      <control channel="0">
        <jointName>left_thruster_joint</jointName>
        <useForce>1</useForce>
        <multiplier>10</multiplier>
        <offset>-0.5</offset>
        <type>VELOCITY</type>
      </control>
      <control channel="1">
        <jointName>right_thruster_joint</jointName>
        <useForce>1</useForce>
        <multiplier>10</multiplier>
        <offset>-0.5</offset>
        <type>VELOCITY</type>
      </control>
    </plugin>
  </model>
</sdf>

